# Gemini API key — used for embeddings in ingest.py and tools.py
# Get it from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Turso database URL — used by log_question and generate_weekly_report
# Get it from: turso db show --url <your-db-name>
TURSO_DATABASE_URL=libsql://your-database-name.turso.io

# Turso auth token — used alongside the URL
# Get it from: turso db tokens create <your-db-name>
TURSO_AUTH_TOKEN=your_turso_auth_token_here